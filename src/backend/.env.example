### QBO Connector (sandbox by default)
QBO_ENV=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=
QBO_TOKEN_EXPIRES_AT=
QBO_ENV_FILE=.env
QBO_TOKEN_STORE_PATH=.qbo_tokens.json
QBO_REDIRECT_URI=
QBO_REDIRECT_URI_DEV=
QBO_OAUTH_SCOPES=com.intuit.quickbooks.accounting
EASYAUTH_ENABLED=false
AAD_TOKEN_VALIDATION_ENABLED=true
ALLOW_SAMPLE_USER_FALLBACK=false
AAD_ALLOWED_AUDIENCES=
AAD_ALLOWED_ISSUERS=
ORCHESTRATION_RUN_TTL_SECONDS=1800
MCP_TOOL_CHOICE_REQUIRED=true
QBO_DEBUG_ENDPOINTS_ENABLED=false
QBO_LEGACY_RECORD_FALLBACK_ENABLED=false
WEBSOCKET_REQUIRE_AUTH=false
CORS_ALLOWED_ORIGINS=

### Google Drive Connector (optional)
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_ACCESS_TOKEN=
DRIVE_TOKEN_EXPIRES_AT=
DRIVE_ROOT_FOLDER_ID=
DRIVE_EVIDENCE_ENABLED=false
DRIVE_EVIDENCE_MANIFEST_FILE_ID=
