    subgraph Registry["Registry"]
      ACR["Azure Container Registry\ncr<solutionSuffix>"]
    end

    %% Core wiring
    WEB -->|HTTPS| CA_BACKEND
    CA_BACKEND -->|MCP streamable-http| CA_MCP

    CA_BACKEND -->|Azure SDK (MI)| COSMOS
    CA_BACKEND -->|Azure SDK (MI)| AISVC
    CA_BACKEND -->|Search query/index\n(API key or AAD)| SRCH
    CA_BACKEND -->|Blob read| ST

    %% AI Foundry uses a project-scoped connection to Search
    AIPROJ --> AIFP_CONN --> SRCH

    %% Key Vault secret is used as Key Vault reference for backend secret
    KV -->|Key Vault reference| CA_BACKEND

    %% Identity assignments (simplified)
    UAMI --> CA_BACKEND
    UAMI --> CA_MCP
    UAMI --> WEB

    %% Image pulls
    ACR --> CA_BACKEND
    ACR --> CA_MCP
    ACR --> WEB

    %% Diagnostics (high-level)
    CAE --> LAW
    CA_BACKEND --> LAW
    CA_MCP --> LAW
    WEB --> LAW
    CA_BACKEND --> APPINS
  end

  %% Optional WAF-aligned private networking (enabled via infra/main.parameters.json)
  subgraph VNET_OPT["Optional: Private Networking (WAF-aligned)"]
    direction LR
    VNET["Virtual Network + Subnets\nbackend / containers / webserverfarm / administration / bastion"]
    PE["Private Endpoints\n(Cosmos, Blob, Key Vault, AI services)\n(Search PE disabled in repo)"]
    PDNS["Private DNS Zones\n(openai, cognitiveservices, documents, blob, vault, search)"]
    BASTION["Azure Bastion (optional)"]
    JUMP["Jumpbox VM (optional)"]
    VNET --> PE --> PDNS
    BASTION --> JUMP
  end
