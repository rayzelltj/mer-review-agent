# MCP Server Configuration

# Server Settings
HOST=0.0.0.0
PORT=9000
DEBUG=false
SERVER_NAME=MacaeMcpServer

# Backend URL — required for finance tools (fan-out calls to the backend API)
# In production this is set automatically via Bicep
BACKEND_URL=http://localhost:8000

# Authentication Settings
ENABLE_AUTH=false
MCP_REQUIRE_USER_AUTH=false
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
JWKS_URI=https://login.microsoftonline.com/your-tenant-id/discovery/v2.0/keys
ISSUER=https://sts.windows.net/your-tenant-id/
AUDIENCE=api://your-client-id
DATASET_PATH=./datasets
