flowchart LR
  %% Azure Deployment Topology (repo-derived from infra/main.bicep)

  subgraph RG["Azure Resource Group (name: TBD)"]
    direction LR

    subgraph Identity["Identity"]
      UAMI["User Assigned Managed Identity\nid-<solutionSuffix>"]
    end

    subgraph Compute["Compute"]
      CAE["Container Apps Environment\ncae-<solutionSuffix>"]
      CA_BACKEND["Container App: Backend\nca-<solutionSuffix>\nIngress: external :8000"]
      CA_MCP["Container App: MCP\nca-mcp-<solutionSuffix>\nIngress: external :9000"]

      ASP["App Service Plan (Linux)\nasp-<solutionSuffix>"]
      WEB["Web App for Containers: Frontend\napp-<solutionSuffix>\nPort: 3000"]
    end

    subgraph AI["AI + Search"]
      AISVC["Azure AI Foundry AI Services\n(aif-<solutionSuffix>)\nModel deployments: gpt-4.1, gpt-4.1-mini, o4-mini"]
      AIPROJ["AI Foundry Project\n(proj-<solutionSuffix>)\nSystem MI"]
      SRCH["Azure AI Search\nsrch-<solutionSuffix>\nPublic Network Access: Enabled (per repo)"]
      AIFP_CONN["AI Project Connection\nMicrosoft.CognitiveServices/.../connections\n(aifp-srch-connection-<solutionSuffix>)\nAuthType: ApiKey"]
    end

    subgraph Data["Data Stores"]
      COSMOS["Cosmos DB (SQL)\ncosmos-<solutionSuffix>\nDB: macae\nContainer: memory"]
      ST["Storage Account (Blob)\nst<solutionSuffix>\nMultiple containers"]
      KV["Key Vault\nkv-<solutionSuffix>\nSecret: AzureAISearchAPIKey"]
